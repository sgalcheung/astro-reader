---
const { pdfUrl } = Astro.props;

const viewerId = `pdf-viewer-${crypto.randomUUID()}`;
---

<div id={viewerId} class="viewerContainer" data-pdf-url={pdfUrl}>
	<div class="viewer pdfViewer"></div>
</div>

<style>
	.viewerContainer {
		left: 60%;
		right: auto;

		width: 256mm;
		max-width: calc(100vw - 2rem);

		transform: translateX(-50%);

		position: absolute;
		overflow: visible !important;
		height: auto !important;
		max-height: none !important;

		/* background: #f9f9f9; */
	}

	.viewer {
		position: relative;
	}
</style>
