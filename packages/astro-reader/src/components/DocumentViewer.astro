---
import {
	type DocumentResource,
	fromImportFile,
	getDocumentViewer,
	type LocalFileContent,
	fromUrlFile,
} from './DocumentViewer.js';
import PDFViewer from './PDFViewer.astro';
import SVGViewer from './SVGViewer.astro';

export interface Props {
	content?: unknown;
	url?: string;
	format?: 'pdf' | 'svg';
	// Allows passing other attributes to PDFViewer/SVGViewer (such as class, style, alt etc.)
	[key: string]: unknown;
}

const { format = 'pdf', content, url, ...restProps } = Astro.props;

let resource: DocumentResource;

function isImportFileContent(data: unknown): data is LocalFileContent {
	return (
		typeof data === 'object' &&
		data !== null &&
		'resourceType' in data &&
		'filePath' in data
	);
}

if (content) {
	if (isImportFileContent(content)) {
		resource = fromImportFile(content, format);
	} else {
		throw new Error('<DocumentViewer> Unrecognized content format.');
	}
} else if (url) {
	resource = await fromUrlFile(url);
} else {
	throw new Error('<DocumentViewer> requires either `content` or `url` prop.');
}

const page = await getDocumentViewer({ cacheFormat: 'svg', ...resource });
---

{format === 'pdf' ? <PDFViewer page={page} /> : <SVGViewer page={page} />}
