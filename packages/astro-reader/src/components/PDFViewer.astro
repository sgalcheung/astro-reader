---
import type { Page } from '../types.js';
import { getState } from '../state.js';

interface Props {
	page: Page;
}

const { enableProxy } = getState();

const { page } = Astro.props;

const fetchTarget = enableProxy
	? `/api/pdf-proxy?key=${encodeURIComponent(btoa(page.src))}`
	: page.src;
// const fetchTarget = enableProxy ? '/api/pdf-proxy' : page.src;

const viewerId = `pdf-viewer-${crypto.randomUUID()}`;
---

<div
	id={viewerId}
	class="viewerContainer"
	data-pdf-target={fetchTarget}
	data-enable-proxy={enableProxy ? 'true' : 'false'}
>
	<div class="viewer pdfViewer"></div>
</div>

<style>
	.viewerContainer {
		left: 60%;
		right: auto;

		width: 256mm;
		max-width: calc(100vw - 2rem);

		transform: translateX(-50%);

		position: absolute;
		overflow: visible !important;
		height: auto !important;
		max-height: none !important;

		/* background: #f9f9f9; */
	}

	.viewer {
		position: relative;
	}
</style>
<script>
	import * as pdfjsLib from 'pdfjs-dist';
	import * as pdfjsViewer from 'pdfjs-dist/web/pdf_viewer.mjs';

	import 'pdfjs-dist/web/pdf_viewer.css';
	import PDFDocument from 'pdfkit/js/pdfkit.standalone';
	import SVGtoPDF from 'svg-to-pdfkit';

	/*
	 * PDF.js Worker
	 */
	pdfjsLib.GlobalWorkerOptions.workerSrc = new URL(
		'pdfjs-dist/build/pdf.worker.mjs',
		import.meta.url,
	).toString();

	/*
	 * Base URL
	 *
	 * /starpdf/
	 */
	const basePath = import.meta.env.BASE_URL;

	const CMAP_URL = basePath ? `${basePath}/cmaps/` : '/cmaps/';

	/*
	 * PDF.js Sandbox
	 */
	const SANDBOX_BUNDLE_SRC = new URL(
		'pdfjs-dist/build/pdf.sandbox.mjs',
		import.meta.url,
	).toString();

	/**
	 * 强制所有层锚定在 .page 的 Content Area (0,0) 点
	 * 修复超链接漂移
	 */
	function fixPdfLayers() {
		const pages = document.querySelectorAll<HTMLElement>('.viewerContainer .page');
		
		for (const page of pages) {
			const canvas = page.querySelector<HTMLCanvasElement>('canvas');
			const annot = page.querySelector<HTMLElement>('.annotationLayer');
			const text = page.querySelector<HTMLElement>('.textLayer');

			if (canvas && annot) {
				// 1. ✅ 核心：获取 Canvas 当前在屏幕上实际渲染的 CSS 尺寸 (已包含任何响应式缩放)
				const rect = canvas.getBoundingClientRect();
				const w = rect.width;
				const h = rect.height;

				// ⚠️ 注意：绝对不要修改 canvas 的任何 style！让 PDF.js 自己管理它。

				// 2. 强制 Annotation Layer 的尺寸与 Canvas 的实际渲染尺寸完全一致
				annot.style.setProperty('width', `${w}px`, 'important');
				annot.style.setProperty('height', `${h}px`, 'important');
				
				// 3. 强制锚定在 (0,0)，清除任何可能的默认边距或变换
				annot.style.setProperty('left', '0px', 'important');
				annot.style.setProperty('top', '0px', 'important');
				annot.style.setProperty('margin', '0px', 'important');
				annot.style.setProperty('transform', 'none', 'important');

				// 4. 同步修复文本选择层
				if (text) {
					text.style.setProperty('width', `${w}px`, 'important');
					text.style.setProperty('height', `${h}px`, 'important');
					text.style.setProperty('left', '0px', 'important');
					text.style.setProperty('top', '0px', 'important');
					text.style.setProperty('margin', '0px', 'important');
					text.style.setProperty('transform', 'none', 'important');
				}

				// 5. ✅ 安全转换：仅当原始值明确是 '%' 时才转换为 px，防止重复计算导致数值爆炸
				const links = annot.querySelectorAll<HTMLElement>('.linkAnnotation');
				for (const link of links) {
					const style = link.style;
					
					// 严格检查：必须包含 '%' 才处理，避免把已经是 'px' 的值再次错误计算
					if (style.left && style.left.includes('%') && style.top && style.top.includes('%')) {
						const leftPct = parseFloat(style.left);
						const topPct = parseFloat(style.top);
						const widthPct = parseFloat(style.width || '0');
						const heightPct = parseFloat(style.height || '0');

						if (!isNaN(leftPct)) {
							style.setProperty('left', `${(leftPct / 100) * w}px`, 'important');
							style.setProperty('top', `${(topPct / 100) * h}px`, 'important');
							style.setProperty('width', `${(widthPct / 100) * w}px`, 'important');
							style.setProperty('height', `${(heightPct / 100) * h}px`, 'important');
              style.setProperty('margin-top', '0px', 'important');
						}
					}
				}
			}
		}
	}

	async function initPdfViewer() {
		const containers =
			document.querySelectorAll<HTMLDivElement>('.viewerContainer');

		for (const container of containers) {
			// 防止重复初始化
			if (container.dataset.initialized === 'true') {
				continue;
			}

			let fetchTarget = container.dataset.pdfTarget;
			const enableProxy = container.dataset.enableProxy === 'true';
			if (enableProxy)
				fetchTarget = basePath ? basePath + fetchTarget : fetchTarget;

			if (!fetchTarget) {
				console.error('[PDF] Target is empty');

				continue;
			}

			/*
			 * PDF.js 要求：
			 *
			 * container
			 *   └── viewer
			 */
			const viewer = container.firstElementChild;

			if (!(viewer instanceof HTMLDivElement)) {
				console.error('[PDF] viewer must be HTMLDivElement');
				continue;
			}

			container.dataset.initialized = 'true';

			const eventBus = new pdfjsViewer.EventBus();

			const pdfLinkService = new pdfjsViewer.PDFLinkService({
				eventBus,
			});

			const pdfFindController = new pdfjsViewer.PDFFindController({
				eventBus,
				linkService: pdfLinkService,
			});

			const pdfScriptingManager = new pdfjsViewer.PDFScriptingManager({
				eventBus,

				sandboxBundleSrc: SANDBOX_BUNDLE_SRC,
			});

			const pdfViewer = new pdfjsViewer.PDFViewer({
				container,
				viewer,
				eventBus,
				linkService: pdfLinkService,
				findController: pdfFindController,
				scriptingManager: pdfScriptingManager,
			});

			pdfLinkService.setViewer(pdfViewer);

			pdfScriptingManager.setViewer(pdfViewer);

			eventBus.on('pagesinit', () => {
				pdfViewer.currentScaleValue = 'page-width';
			});

			// ✅ 监听页面渲染完成事件，立即修正尺寸
			eventBus.on('pageviewrendered', () => {
				setTimeout(fixPdfLayers, 50);
			});

			const response = await fetch(fetchTarget, {
				headers: {
					'x-requested-with': 'XMLHttpRequest',
				},
			});

			let objectURL = '';

			// SVG => PDF
			if (response.url.endsWith('svg')) {
				objectURL = await generatePdfBlobFromSvg(response);
			} else {
				// PDF file directly
				const blob = await response.blob();
				objectURL = URL.createObjectURL(blob);
			}

			container.dataset.blobUrl = objectURL;

			// PDF.js Loading
			const loadingTask = pdfjsLib.getDocument({
				// data: arrayBuffer,
				url: objectURL,
				cMapUrl: CMAP_URL,
				cMapPacked: true,
				enableXfa: false,
			});

			// wait PDF.js
			const pdfDocument = await loadingTask.promise;

			pdfViewer.setDocument(pdfDocument);

			pdfLinkService.setDocument(pdfDocument, null);

			// ✅ 兜底：确保文档加载后至少执行一次修正
			setTimeout(fixPdfLayers, 300);
		}
	}

	/**
	 * 将 SVG 文本异步转换为 PDF Blob URL
	 * @param {string} svgText - SVG 字符串
	 * @param {number} width - PDF 宽度
	 * @param {number} height - PDF 高度
	 * @returns {Promise<string>} 返回生成的 Blob URL
	 */
	async function generatePdfBlobFromSvg(response: Response): Promise<string> {
		const svgText = await response.text();

		// Parse SVG string to DOM
		const parser = new DOMParser();
		const svgDoc = parser.parseFromString(svgText, 'image/svg+xml');
		const svgElement = svgDoc.documentElement;

		// Get width and height
		const width = parseInt(svgElement.getAttribute('width')!);
		const height = parseInt(svgElement.getAttribute('height')!);

		if (!response.ok) {
			throw new Error(
				`Failed to fetch PDF: ${response.status} ${response.statusText}`,
			);
		}

		return new Promise((resolve, reject) => {
			const doc = new PDFDocument({
				compress: false,
				size: [width, height],
			});

			const chunks: Uint8Array[] = [];

			// 1. 收集数据块 (浏览器中 chunk 是 Uint8Array)
			doc.on('data', (chunk) => {
				chunks.push(chunk);
			});

			// 2. 生成完成，创建 Blob 并 resolve
			doc.on('end', () => {
				try {
					// 浏览器原生高效合并 Uint8Array 数组
					const blob = new Blob(chunks as unknown as BlobPart[], {
						type: 'application/pdf',
					});
					const objectURL = URL.createObjectURL(blob);
					resolve(objectURL);
				} catch (error) {
					reject(new Error(`Failed to create Blob: ${error}`));
				}
			});

			// 3. 错误处理
			doc.on('error', (err) => {
				reject(err);
			});

			// 4. 执行 SVG 到 PDF 的绘制
			try {
				SVGtoPDF(doc, svgText, 0, 0, {
					width,
					height,
					preserveAspectRatio: 'xMidYMid meet',
				});

				// 5. 结束写入，触发 'end' 事件
				doc.end();
			} catch (error) {
				reject(error);
			}
		});
	}

	function cleanupOldBlobs() {
		const containers =
			document.querySelectorAll<HTMLDivElement>('.viewerContainer');
		for (const container of containers) {
			if (container.dataset.blobUrl) {
				URL.revokeObjectURL(container.dataset.blobUrl);
				delete container.dataset.blobUrl;
			}
		}
	}

	/*
	 * Astro Component 的 script
	 * 可能比组件 DOM 更早执行。
	 */
	setTimeout(() => {
		initPdfViewer().catch((error) => {
			console.error('[PDF] initialization failed:', error);
		});
	}, 0);

	/*
	 * Starlight 客户端导航
	 */
	document.addEventListener('astro:before-swap', () => {
		cleanupOldBlobs();
	});
	document.addEventListener('astro:after-swap', () => {
		setTimeout(() => {
			initPdfViewer().catch((error) => {
				console.error('[PDF] navigation initialization failed:', error);
			});
		}, 0);
	});
</script>
