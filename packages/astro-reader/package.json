{
  "name": "astro-reader",
  "version": "0.0.0",
  "description": "A lightweight PDF reader built with Astro and Starlight.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": "./src/ui.ts",
    "./DocumentViewer": {
      "types": "./dist/components/DocumentViewer.d.ts",
      "import": "./dist/components/DocumentViewer.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "withastro",
    "utils"
  ],
  "author": "Sgal Cheung",
  "repository": {
    "type": "git",
    "url": "https://github.com/sgalcheung/astro-reader.git"
  },
  "bugs": "https://github.com/sgalcheung/astro-reader.git",
  "homepage": "https://sgalcheung.github.io/astro-reader",
  "license": "MIT",
  "peerDependencies": {
    "astro": "^6.0.0"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "astro-emit-asset": "^0.1.4",
    "markdown2typst": "^0.1.4",
    "pdfjs-dist": "^5.7.284",
    "pdfkit": "^0.19.1",
    "svg-to-pdfkit": "^0.1.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pdfkit": "^0.17.6",
    "@types/svg-to-pdfkit": "^0.1.4",
    "acorn": "^8.18.0",
    "tsdown": "0.22.14",
    "typescript": "catalog:"
  }
}
